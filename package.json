{
  "name": "relovation",
  "private": true,
  "version": "1.0.0",
  "description": "Relovation website - Cloudflare Worker met statische assets en contactformulier",
  "scripts": {
    "dev": "wrangler dev",
    "i18n": "node tools/build-i18n.mjs",
    "i18n:check": "node tools/build-i18n.mjs --check",
    "content": "node tools/build-content.mjs",
    "content:extract": "node tools/build-content.mjs --extract",
    "cms:config": "node tools/build-cms-config.mjs",
    "build:site": "npm run i18n && npm run content && npm run cms:config",
    "deploy": "npm run build:site && wrangler deploy",
    "tail": "wrangler tail",
    "qa:flow": "playwright test tests/aanvraag-flow.spec.ts",
    "qa:responsive": "playwright test tests/responsive.spec.ts",
    "qa:breakpoints": "playwright test tests/breakpoint-edges.spec.ts",
    "qa:text": "playwright test tests/text-scaling.spec.ts",
    "qa:a11y": "playwright test tests/accessibility.spec.ts",
    "qa": "npm run qa:flow && npm run qa:responsive && npm run qa:breakpoints && npm run qa:text",
    "qa:shots": "playwright test tests/shots.spec.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "wrangler": "^4.111.0"
  }
}
