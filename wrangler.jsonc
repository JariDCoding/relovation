{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relovation",
  "main": "src/index.js",
  "compatibility_date": "2026-07-15",

  // Statische bestanden worden rechtstreeks door Cloudflare's asset-laag
  // geserveerd; de Worker wordt daarvoor niet eens aangeroepen.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",

    // Reproduceert het huidige Pages-gedrag exact:
    //   /contact       -> serveert contact.html
    //   /contact.html  -> 308 naar /contact
    // Bestaande links blijven dus werken.
    "html_handling": "auto-trailing-slash",

    // Echte 404's op onbekende URL's (Pages gaf overal 200 + HTML terug,
    // wat gebroken assets verborg en rommel liet indexeren).
    "not_found_handling": "none"
  },

  // Bestemming en afzender van het contact- en aanvraagformulier.
  //
  // TIJDELIJK: aanvragen komen in Jari's inbox, niet bij Robin.
  //
  // De bedoeling is CONTACT_TO = "relovation@robinmusic.be" met CONTACT_FROM =
  // "Relovation <aanvraag@relovation.be>". Dat kan pas als relovation.be
  // geverifieerd is bij Resend: zolang dat niet zo is, weigert Resend elke
  // ontvanger behalve contact@jdcreations.co met een 403 en geeft het formulier
  // een 502 -- de lead is dan weg. Liever in de verkeerde inbox dan verloren.
  //
  // Omzetten zodra de DNS-records erin staan: zie docs/resend-dns-records.md.
  // Twee regels wijzigen, `npx wrangler deploy`, klaar. Geen codewijziging.
  "vars": {
    "CONTACT_FROM": "Relovation <onboarding@resend.dev>",
    "CONTACT_TO": "contact@jdcreations.co"
  },

  // RESEND_API_KEY is een secret, geen var. Zetten met:
  //   npx wrangler secret put RESEND_API_KEY
  // Lokaal staat hij in .dev.vars (gitignored).

  "observability": { "enabled": true }
}
