{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relovation",
  "main": "src/index.js",
  "compatibility_date": "2026-07-15",

  // Statische bestanden worden rechtstreeks door Cloudflare's asset-laag
  // geserveerd; de Worker wordt daarvoor niet eens aangeroepen.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",

    // Reproduceert het huidige Pages-gedrag exact:
    //   /contact       -> serveert contact.html
    //   /contact.html  -> 308 naar /contact
    // Bestaande links blijven dus werken.
    "html_handling": "auto-trailing-slash",

    // Echte 404's op onbekende URL's (Pages gaf overal 200 + HTML terug,
    // wat gebroken assets verborg en rommel liet indexeren).
    "not_found_handling": "none"
  },

  // Bestemming en afzender van het contactformulier. Bewust vars i.p.v. code:
  // als relovation.be live gaat, wijzig je deze twee regels en klaar.
  //
  // Nu: Resend's testafzender (werkt zonder eigen domein) naar Jari's inbox.
  // Later: "formulier@relovation.be" -> mailbox van Relovation.
  "vars": {
    "CONTACT_FROM": "Relovation <onboarding@resend.dev>",
    "CONTACT_TO": "contact@jdcreations.co"
  },

  // RESEND_API_KEY is een secret, geen var. Zetten met:
  //   npx wrangler secret put RESEND_API_KEY
  // Lokaal staat hij in .dev.vars (gitignored).

  "observability": { "enabled": true }
}
