# Security-headers voor alle pagina's en assets.
# Geen CSP: de site gebruikt bewust inline styles/scripts.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Beeldmateriaal en merkbestanden veranderen zelden en dragen een eigen naam.
# Een jaar cache scheelt herhaalde downloads bij terugkerende bezoekers, wat
# rechtstreeks in de Core Web Vitals telt.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Het CMS mag nooit gecachet of geïndexeerd worden. X-Frame-Options staat
# hierboven al op DENY, dus /admin kan ook niet in een iframe gezet worden.
/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# CSS en JS wél herzien bij elke deploy: geen hash in de bestandsnaam.
/*.css
  Cache-Control: public, max-age=3600, must-revalidate

/*.js
  Cache-Control: public, max-age=3600, must-revalidate
